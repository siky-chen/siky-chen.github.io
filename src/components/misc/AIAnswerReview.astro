---
interface Props {
	articleTitle: string;
	apiUrl?: string;
}

const {
	articleTitle,
	apiUrl = import.meta.env.PUBLIC_AI_REVIEW_API_URL || "/api/evaluate-answer",
} = Astro.props;
---

<div
	id="ai-answer-review-root"
	data-article-title={articleTitle}
	data-api-url={apiUrl}
></div>

<script is:inline>
(() => {
	const w = window;
	const BOOTSTRAP_KEY = "__aiAnswerReviewBootstrapped";

	function createTextElement(tag, className, text) {
		const element = document.createElement(tag);
		if (className) element.className = className;
		if (text) element.textContent = text;
		return element;
	}

	function normalizeText(text) {
		return (text || "").replace(/\s+/g, " ").trim();
	}

	function escapeStorageKey(text) {
		return encodeURIComponent(text).slice(0, 160);
	}

	function getPageStorageKey(suffix) {
		return `ai-answer-review:${window.location.pathname}:${suffix}`;
	}

	function getQuestionScoreId(questionText) {
		return escapeStorageKey(questionText);
	}

	function readJsonStorage(key, fallback) {
		try {
			const raw = window.localStorage.getItem(key);
			if (!raw) return fallback;
			return JSON.parse(raw);
		} catch {
			return fallback;
		}
	}

	function writeJsonStorage(key, value) {
		try {
			window.localStorage.setItem(key, JSON.stringify(value));
		} catch {}
	}

	function getQuestionHistoryKey(questionId) {
		return getPageStorageKey(`question-history:${questionId}`);
	}

	function getQuestionScoreHistory(questionId) {
		const data = readJsonStorage(getQuestionHistoryKey(questionId), []);
		return Array.isArray(data) ? data : [];
	}

	function appendQuestionScoreHistory(questionId, record) {
		const history = getQuestionScoreHistory(questionId);
		history.unshift(record);
		writeJsonStorage(getQuestionHistoryKey(questionId), history.slice(0, 12));
	}

	function getLatestQuestionScore(questionId) {
		const history = getQuestionScoreHistory(questionId);
		if (!history.length) return null;
		const latest = history[0];
		if (!latest || typeof latest !== "object") return null;
		return {
			score: Number(latest.score) || 0,
			timestamp: latest.timestamp || "",
		};
	}

	function formatRecordTime(timestamp) {
		try {
			return new Date(timestamp).toLocaleString("zh-CN", {
				month: "2-digit",
				day: "2-digit",
				hour: "2-digit",
				minute: "2-digit",
			});
		} catch {
			return "";
		}
	}

	function getRootConfig() {
		const root = document.getElementById("ai-answer-review-root");
		if (!root) return null;

		return {
			apiUrl: root.dataset.apiUrl || "/api/evaluate-answer",
			articleTitle: root.dataset.articleTitle || "",
		};
	}

	function getContentContainers() {
		const containers = Array.from(
			document.querySelectorAll(".markdown-content.custom-md, #decrypted-content"),
		).filter((node) => node instanceof HTMLElement);

		return containers.filter((container) => {
			return !containers.some((other) => {
				return other !== container && other.contains(container);
			});
		});
	}

	function extractReferenceAnswer(details) {
		if (!(details instanceof HTMLDetailsElement)) return "";

		const clone = details.cloneNode(true);
		const summary = clone.querySelector("summary");
		if (summary) {
			summary.remove();
		}
		return normalizeText(clone.textContent || "");
	}

	function getHeadingContext(container, heading) {
		const headings = Array.from(container.querySelectorAll("h2, h3, h4"));
		const currentIndex = headings.indexOf(heading);
		let sectionTitle = "";
		let subSectionTitle = "";

		for (let i = currentIndex - 1; i >= 0; i -= 1) {
			const current = headings[i];
			if (!subSectionTitle && current.tagName === "H3") {
				subSectionTitle = normalizeText(current.textContent || "");
			}
			if (current.tagName === "H2") {
				sectionTitle = normalizeText(current.textContent || "");
				break;
			}
		}

		return { sectionTitle, subSectionTitle };
	}

	function buildResultList(title, items) {
		if (!Array.isArray(items) || items.length === 0) return null;

		const block = createTextElement("div", "ai-answer-review-result-block", "");
		const heading = createTextElement(
			"div",
			"ai-answer-review-result-title",
			title,
		);
		const list = createTextElement("ul", "ai-answer-review-result-list", "");

		items.forEach((item) => {
			if (!item) return;
			list.appendChild(createTextElement("li", "", String(item)));
		});

		block.appendChild(heading);
		block.appendChild(list);
		return block;
	}

	function buildRubricBlock(rubricScores) {
		if (!Array.isArray(rubricScores) || rubricScores.length === 0) return null;

		const block = createTextElement("div", "ai-answer-review-result-block", "");
		block.appendChild(
			createTextElement("div", "ai-answer-review-result-title", "Rubric 评分"),
		);

		const list = createTextElement("ul", "ai-answer-review-rubric-list", "");

		rubricScores.forEach((item) => {
			if (!item || typeof item !== "object") return;

			const entry = createTextElement("li", "ai-answer-review-rubric-item", "");
			const label = createTextElement(
				"div",
				"ai-answer-review-rubric-label",
				"",
			);
			const score = createTextElement(
				"div",
				"ai-answer-review-rubric-score",
				"",
			);
			const reason = createTextElement(
				"div",
				"ai-answer-review-rubric-reason",
				"",
			);

			const itemLabel = item.label || item.key || "未命名维度";
			label.textContent = String(itemLabel);
			score.textContent = `${Number(item.score || 0)}/5 · ${Number(
				item.weight || 0,
			)}%`;
			reason.textContent = item.reason ? String(item.reason) : "";

			entry.appendChild(label);
			entry.appendChild(score);
			if (reason.textContent) {
				entry.appendChild(reason);
			}
			list.appendChild(entry);
		});

		if (!list.children.length) return null;

		block.appendChild(list);
		return block;
	}

	function renderResult(resultNode, data) {
		resultNode.innerHTML = "";
		resultNode.hidden = false;

		const summary = createTextElement("div", "ai-answer-review-result-summary", "");
		const score = createTextElement(
			"div",
			"ai-answer-review-score",
			`${Number(data.score || 0)}/100`,
		);
		const verdict = createTextElement(
			"div",
			"ai-answer-review-verdict",
			data.verdict || "已完成评分",
		);
		const desc = createTextElement(
			"p",
			"ai-answer-review-result-desc",
			data.summary || "",
		);

		summary.appendChild(score);
		summary.appendChild(verdict);
		resultNode.appendChild(summary);
		if (desc.textContent) {
			resultNode.appendChild(desc);
		}

		const strengths = buildResultList("回答亮点", data.strengths);
		const improvements = buildResultList("改进建议", data.improvements);
		const followUps = buildResultList("可能追问", data.followUps);
		const rubric = buildRubricBlock(data.rubricScores);

		if (strengths) resultNode.appendChild(strengths);
		if (rubric) resultNode.appendChild(rubric);
		if (improvements) resultNode.appendChild(improvements);

		if (data.betterAnswer) {
			const better = createTextElement(
				"div",
				"ai-answer-review-result-block",
				"",
			);
			better.appendChild(
				createTextElement("div", "ai-answer-review-result-title", "优化表达"),
			);
			better.appendChild(
				createTextElement(
					"p",
					"ai-answer-review-result-desc ai-answer-review-better-answer",
					String(data.betterAnswer),
				),
			);
			resultNode.appendChild(better);
		}

		if (followUps) resultNode.appendChild(followUps);
	}

	function renderQuestionHistory(questionId, historyList, historyEmpty) {
		if (!(historyList instanceof HTMLElement) || !(historyEmpty instanceof HTMLElement)) {
			return;
		}

		historyList.innerHTML = "";
		const history = getQuestionScoreHistory(questionId);
		historyEmpty.hidden = history.length > 0;

		history.forEach((record) => {
			if (!record || typeof record !== "object") return;

			const item = createTextElement("li", "ai-answer-review-history-item", "");
			const meta = createTextElement(
				"div",
				"ai-answer-review-history-meta",
				formatRecordTime(record.timestamp),
			);
			const score = createTextElement(
				"div",
				"ai-answer-review-history-score",
				`${Number(record.score || 0)} / 100`,
			);
			const verdict = createTextElement(
				"div",
				"ai-answer-review-history-detail",
				record.verdict || "已完成评分",
			);

			item.appendChild(meta);
			item.appendChild(score);
			item.appendChild(verdict);
			historyList.appendChild(item);
		});
	}

	function updateWeakestQuestions(container) {
		if (!(container instanceof HTMLElement)) return;

		const intro = container.querySelector(".ai-answer-review-intro");
		if (!(intro instanceof HTMLElement)) return;

		const list = intro.querySelector("[data-role='weakest-list']");
		const empty = intro.querySelector("[data-role='weakest-empty']");
		if (!(list instanceof HTMLElement) || !(empty instanceof HTMLElement)) return;

		const weakestQuestions = Array.from(container.querySelectorAll("h4"))
			.map((heading) => {
				const questionText = normalizeText(heading.textContent || "");
				if (!/^Q\d+\./i.test(questionText)) return null;
				const latest = getLatestQuestionScore(getQuestionScoreId(questionText));
				if (!latest) return null;
				return {
					questionText,
					score: latest.score,
					timestamp: latest.timestamp,
				};
			})
			.filter(Boolean)
			.sort((a, b) => {
				if (a.score !== b.score) return a.score - b.score;
				return String(b.timestamp).localeCompare(String(a.timestamp));
			})
			.slice(0, 5);

		list.innerHTML = "";
		empty.hidden = weakestQuestions.length > 0;

		weakestQuestions.forEach((item) => {
			const entry = createTextElement("li", "ai-answer-review-weakest-item", "");
			const question = createTextElement(
				"div",
				"ai-answer-review-weakest-question",
				item.questionText,
			);
			const meta = createTextElement(
				"div",
				"ai-answer-review-weakest-score",
				`${item.score} / 100`,
			);
			entry.appendChild(question);
			entry.appendChild(meta);
			list.appendChild(entry);
		});
	}

	function renderError(resultNode, message) {
		resultNode.innerHTML = "";
		resultNode.hidden = false;
		resultNode.appendChild(
			createTextElement(
				"p",
				"ai-answer-review-error",
				message || "AI 评分失败，请稍后重试。",
			),
		);
	}

	async function reviewAnswer(config, payload) {
		const response = await fetch(config.apiUrl, {
			method: "POST",
			headers: {
				"Content-Type": "application/json",
			},
			body: JSON.stringify(payload),
		});

		if (!response.ok) {
			let errorMessage = "AI 评分接口暂时不可用。";
			try {
				const errorData = await response.json();
				if (errorData && errorData.error) {
					errorMessage = String(errorData.error);
				}
			} catch {}

			if (response.status === 404) {
				errorMessage =
					"没有找到 AI 评分接口。若博客部署在 GitHub Pages，请把 PUBLIC_AI_REVIEW_API_URL 指向你的 Vercel /api/evaluate-answer 地址。";
			}
			throw new Error(errorMessage);
		}

		return response.json();
	}

	function createPracticeWidget(config, container, heading) {
		if (!(heading instanceof HTMLHeadingElement)) return;
		if (heading.dataset.aiReviewEnhanced === "true") return;

		const questionText = normalizeText(heading.textContent || "");
		if (!/^Q\d+\./i.test(questionText)) return;

		const nextNode = heading.nextElementSibling;
		const referenceAnswer =
			nextNode && nextNode.tagName === "DETAILS"
				? extractReferenceAnswer(nextNode)
				: "";
		const { sectionTitle, subSectionTitle } = getHeadingContext(
			container,
			heading,
		);

		const widget = createTextElement("section", "ai-answer-review", "");
		const topBar = createTextElement("div", "ai-answer-review-topbar", "");
		const toggleButton = createTextElement(
			"button",
			"ai-answer-review-toggle",
			"开始练习",
		);
		toggleButton.type = "button";
		const hint = createTextElement(
			"p",
			"ai-answer-review-hint",
			"建议先自己作答，再展开参考答案对照。",
		);

		const panel = createTextElement("div", "ai-answer-review-panel", "");
		panel.hidden = true;

		const label = createTextElement("label", "ai-answer-review-label", "我的回答");
		const textarea = document.createElement("textarea");
		textarea.className = "ai-answer-review-textarea";
		textarea.placeholder = "把你的回答写在这里，建议按“定义 -> 原理 -> 项目经验”结构回答。";
		textarea.rows = 6;

		const actionRow = createTextElement("div", "ai-answer-review-actions", "");
		const scoreButton = createTextElement(
			"button",
			"ai-answer-review-button ai-answer-review-button-primary",
			"AI 评分",
		);
		scoreButton.type = "button";
		const clearButton = createTextElement(
			"button",
			"ai-answer-review-button",
			"清空",
		);
		clearButton.type = "button";

		const helper = createTextElement(
			"p",
			"ai-answer-review-helper",
			"评分会结合题目、参考答案和 rubric，从准确性、完整性、逻辑性、项目结合度几个维度给建议。",
		);
		const historySection = createTextElement(
			"section",
			"ai-answer-review-history-panel",
			"",
		);
		const historyToggle = createTextElement(
			"button",
			"ai-answer-review-button ai-answer-review-history-toggle",
			"历史分数",
		);
		historyToggle.type = "button";
		const historyContent = createTextElement(
			"div",
			"ai-answer-review-history-content",
			"",
		);
		historyContent.hidden = true;
		const historyEmpty = createTextElement(
			"p",
			"ai-answer-review-history-empty",
			"还没有这道题的历史分数。",
		);
		const historyList = createTextElement(
			"ul",
			"ai-answer-review-history-list",
			"",
		);
		const resultNode = createTextElement("div", "ai-answer-review-result", "");
		resultNode.hidden = true;

		const questionId = getQuestionScoreId(questionText);
		const storageKey = `ai-answer-review:${window.location.pathname}:${questionId}`;
		const savedAnswer = window.localStorage.getItem(storageKey);
		if (savedAnswer) {
			textarea.value = savedAnswer;
		}

		textarea.addEventListener("input", () => {
			window.localStorage.setItem(storageKey, textarea.value);
		});

		toggleButton.addEventListener("click", () => {
			const nextHidden = !panel.hidden;
			panel.hidden = nextHidden;
			toggleButton.textContent = nextHidden ? "开始练习" : "收起练习";
		});

		historyToggle.addEventListener("click", () => {
			const nextHidden = !historyContent.hidden;
			historyContent.hidden = nextHidden;
			historyToggle.textContent = nextHidden ? "历史分数" : "收起历史";
		});

		clearButton.addEventListener("click", () => {
			textarea.value = "";
			resultNode.hidden = true;
			resultNode.innerHTML = "";
			window.localStorage.removeItem(storageKey);
		});

		scoreButton.addEventListener("click", async () => {
			const answer = normalizeText(textarea.value);
			if (!answer) {
				renderError(resultNode, "先写一点自己的回答，再让 AI 评分会更有意义。");
				return;
			}

			scoreButton.disabled = true;
			scoreButton.textContent = "评分中...";

			try {
				const result = await reviewAnswer(config, {
					articleTitle: config.articleTitle,
					sectionTitle,
					subSectionTitle,
					question: questionText,
					referenceAnswer,
					answer,
				});
				renderResult(resultNode, result);
				const scoreValue = Number(result && result.score) || 0;
				appendQuestionScoreHistory(questionId, {
					timestamp: new Date().toISOString(),
					score: scoreValue,
					verdict: result && result.verdict ? String(result.verdict) : "",
				});
				renderQuestionHistory(questionId, historyList, historyEmpty);
				updateWeakestQuestions(container);
			} catch (error) {
				const message =
					error instanceof Error ? error.message : "AI 评分失败，请稍后重试。";
				renderError(resultNode, message);
			} finally {
				scoreButton.disabled = false;
				scoreButton.textContent = "AI 评分";
			}
		});

		topBar.appendChild(toggleButton);
		topBar.appendChild(hint);
		actionRow.appendChild(scoreButton);
		actionRow.appendChild(clearButton);

		historyContent.appendChild(historyEmpty);
		historyContent.appendChild(historyList);
		historySection.appendChild(historyToggle);
		historySection.appendChild(historyContent);

		panel.appendChild(label);
		panel.appendChild(textarea);
		panel.appendChild(actionRow);
		panel.appendChild(helper);
		panel.appendChild(historySection);
		panel.appendChild(resultNode);

		widget.appendChild(topBar);
		widget.appendChild(panel);

		heading.insertAdjacentElement("afterend", widget);
		heading.dataset.aiReviewEnhanced = "true";
		renderQuestionHistory(questionId, historyList, historyEmpty);
	}

	function injectIntroCard(container) {
		if (!(container instanceof HTMLElement)) return;
		if (container.dataset.aiReviewIntroAdded === "true") return;

		const firstQuestion = Array.from(container.querySelectorAll("h4")).find((node) => {
			return /^Q\d+\./i.test(normalizeText(node.textContent || ""));
		});
		if (!(firstQuestion instanceof HTMLElement)) return;

		const intro = createTextElement("div", "ai-answer-review-intro", "");
		intro.appendChild(
			createTextElement(
				"strong",
				"ai-answer-review-intro-title",
				"练习模式已启用",
			),
		);
		intro.appendChild(
			createTextElement(
				"p",
				"ai-answer-review-intro-desc",
				"每道题下方都可以点“开始练习”，先写自己的回答，再让 AI 评分并给改进建议。",
			),
		);
		intro.appendChild(
			createTextElement(
				"div",
				"ai-answer-review-weakest-title",
				"最近一次测试成绩最低的 5 道题",
			),
		);
		const weakestEmpty = createTextElement(
			"p",
			"ai-answer-review-weakest-empty",
			"还没有评分记录，做过题之后这里会自动显示。",
		);
		weakestEmpty.dataset.role = "weakest-empty";
		const weakestList = createTextElement(
			"ul",
			"ai-answer-review-weakest-list",
			"",
		);
		weakestList.dataset.role = "weakest-list";
		intro.appendChild(weakestEmpty);
		intro.appendChild(weakestList);

		firstQuestion.insertAdjacentElement("beforebegin", intro);
		container.dataset.aiReviewIntroAdded = "true";
		updateWeakestQuestions(container);
	}

	function enhanceReviewWidgets() {
		const config = getRootConfig();
		if (!config) return;

		getContentContainers().forEach((container) => {
			injectIntroCard(container);
			Array.from(container.querySelectorAll("h4")).forEach((heading) => {
				createPracticeWidget(config, container, heading);
			});
		});
	}

	if (!w[BOOTSTRAP_KEY]) {
		w[BOOTSTRAP_KEY] = true;

		const observer = new MutationObserver(() => {
			enhanceReviewWidgets();
		});

		if (document.body) {
			observer.observe(document.body, {
				childList: true,
				subtree: true,
			});
		}

		document.addEventListener("DOMContentLoaded", enhanceReviewWidgets);
		document.addEventListener("astro:after-swap", enhanceReviewWidgets);

		if (w.swup && w.swup.hooks && typeof w.swup.hooks.on === "function") {
			w.swup.hooks.on("content:replace", enhanceReviewWidgets);
		}
	}

	enhanceReviewWidgets();
})();
</script>

<style is:global>
.ai-answer-review-intro {
	margin: 0 0 1.25rem;
	padding: 1rem 1rem 0.95rem;
	border: 1px solid color-mix(in oklch, var(--primary) 22%, var(--line-divider));
	border-radius: 1rem;
	background:
		linear-gradient(135deg, color-mix(in oklch, var(--primary) 8%, transparent), transparent 58%),
		color-mix(in oklch, var(--card-bg) 92%, var(--primary) 8%);
}

.ai-answer-review-intro-title {
	display: block;
	margin-bottom: 0.35rem;
	color: var(--primary);
	font-size: 0.98rem;
}

.ai-answer-review-intro-desc {
	margin: 0;
	font-size: 0.92rem;
	line-height: 1.6;
}

.ai-answer-review-weakest-title {
	margin-top: 0.85rem;
	font-size: 0.92rem;
	font-weight: 700;
	color: var(--primary);
}

.ai-answer-review-weakest-empty {
	margin: 0.4rem 0 0;
	font-size: 0.9rem;
	line-height: 1.6;
	color: color-mix(in oklch, currentColor 72%, transparent);
}

.ai-answer-review-weakest-list {
	margin: 0.7rem 0 0;
	padding: 0;
	list-style: none;
	display: grid;
	gap: 0.55rem;
}

.ai-answer-review-weakest-item {
	display: flex;
	align-items: flex-start;
	justify-content: space-between;
	gap: 0.75rem;
	padding: 0.7rem 0.8rem;
	border-radius: 0.9rem;
	border: 1px solid color-mix(in oklch, var(--primary) 14%, var(--line-divider));
	background: color-mix(in oklch, var(--card-bg) 92%, var(--primary) 5%);
}

.ai-answer-review-weakest-question {
	font-size: 0.9rem;
	line-height: 1.6;
}

.ai-answer-review-weakest-score {
	flex-shrink: 0;
	font-size: 0.9rem;
	font-weight: 700;
	color: var(--primary);
}

.ai-answer-review-history-meta,
.ai-answer-review-history-detail {
	font-size: 0.9rem;
	line-height: 1.6;
	color: color-mix(in oklch, currentColor 72%, transparent);
}

.ai-answer-review-history-empty {
	margin: 0.4rem 0 0;
	font-size: 0.9rem;
	line-height: 1.6;
	color: color-mix(in oklch, currentColor 72%, transparent);
}

.ai-answer-review-history-list {
	margin: 0.65rem 0 0;
	padding: 0;
	list-style: none;
	display: grid;
	gap: 0.65rem;
}

.ai-answer-review-history-item {
	padding: 0.7rem 0.85rem;
	border-radius: 0.9rem;
	border: 1px solid color-mix(in oklch, var(--primary) 12%, var(--line-divider));
	background: color-mix(in oklch, var(--card-bg) 92%, var(--primary) 5%);
}

